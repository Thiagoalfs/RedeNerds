# ========================================================
# FORÇAR HTTPS (Compatível com Apache, LiteSpeed, Cloudflare e Nginx Proxy)
# ========================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirecionamento 301 da rota de novidades para a secao da home
    RewriteRule ^novidades/?$ /#atualizacoes-section [R=301,L,NE]

    # Redirecionamento do webmail para o servidor da Homehost (302 para não travar cache se mudar depois)
    RewriteRule ^webmail(/.*)?$ https://h58.servidorhh.com/webmail/ [R=302,L]

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteCond %{HTTP:CF-Visitor} !'"scheme":"https"'
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ========================================================
# HEADERS DE SEGURANÇA E HSTS
# ========================================================
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

ErrorDocument 404 /errors/404/index.html
ErrorDocument 429 /errors/429/index.html

# Bloqueia acesso web às pastas .git e docker-init
<IfModule mod_rewrite.c>
    RewriteRule ^(\.git|docker-init)(/|$) - [F,L]
</IfModule>

# Bloqueia arquivos sensíveis, dumps SQL e arquivos de infraestrutura
<FilesMatch "^(config\.php|\.env(\..*)?|Dockerfile|docker-compose\.yml|Caddyfile|\.gitignore|\.dockerignore)$|\.sql$">
    Require all denied
</FilesMatch>