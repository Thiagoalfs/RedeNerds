# ========================================================
# BANCO DE DADOS
# ========================================================
# No Docker Compose na VPS, utilize: DB_HOST=db
DB_HOST=db
DB_NAME=redenerds
DB_USER=redenerds_user
DB_PASS=sua_senha_segura_aqui
DB_ROOT_PASSWORD=senha_root_do_mysql_aqui

# ========================================================
# CHAVE SECRETA DA API (Servidores / Plugins / Bots)
# ========================================================
API_SECRET_KEY=sua_chave_secreta_de_api_aqui

# ========================================================
# DISCORD WEBHOOKS
# ========================================================
DISCORD_WEBHOOK_ANUNCIOS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_ATUALIZACOES=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_LOJA=https://discord.com/api/webhooks/...

# ========================================================
# MERCADO PAGO
# ========================================================
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=seu_webhook_secret_aqui

# ========================================================
# DELIVERY (SERVIDORES MINECRAFT)
# ========================================================
DELIVERY_DEFAULT_URL=http://host:porta/api/v1/deliveries
DELIVERY_DEFAULT_TOKEN=seu_token_aqui

DELIVERY_COBBLENERD_URL=http://host:porta/api/v1/deliveries
DELIVERY_COBBLENERD_TOKEN=seu_token_aqui

DELIVERY_POTATOSKY_URL=http://host:porta/api/v1/deliveries
DELIVERY_POTATOSKY_TOKEN=seu_token_aqui

DELIVERY_AEROCITY_URL=http://host:porta/api/v1/deliveries
DELIVERY_AEROCITY_TOKEN=seu_token_aqui

DELIVERY_DREFRIENDS_URL=http://host:porta/api/v1/deliveries
DELIVERY_DREFRIENDS_TOKEN=seu_token_aqui
